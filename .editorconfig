# https://editorconfig.org
#
# Keeps editors consistent with the LF-only policy enforced by .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# PSR-12 (see phpcs.xml).
[*.php]
indent_style = space
indent_size = 4

[*.yml]
indent_style = space
indent_size = 2

# Trailing whitespace is significant in Markdown (two spaces = hard line
# break), and specifications/ holds verbatim copies of external documents.
[*.md]
trim_trailing_whitespace = false
